#!/usr/bin/env bash
#
# Add a Signed-off-by line when one is missing.
#
# docs/rules.md §9.6 requires every commit to carry one, and CI rejects a pull
# request without it. Remembering `-s` on every commit is exactly the kind of
# thing people forget once and then have to rewrite a branch to fix, so this
# does it for you.
#
# Enable per clone:
#
#	git config core.hooksPath .githooks
#
# It is opt-in because Git will not let a repository configure its own hooks —
# a repository that could would run code on your machine the moment you cloned
# it. That is a security property, not an oversight.
set -euo pipefail

msg_file="$1"
# $2 is the message source: "message", "template", "merge", "squash", "commit".
# Empty means an ordinary interactive commit.
source="${2-}"

# Never touch a message that already has the trailer. `git commit -s` adds one
# itself, and a second identical line is a malformed trailer block rather than
# a harmless duplicate.
if grep -qiE '^Signed-off-by: .+ <.+@.+>' "$msg_file"; then
	exit 0
fi

# A merge message is generated by Git, not written by a contributor, so there
# is nobody to attest anything — and the DCO check skips merges for the same
# reason. A squash message is assembled from commits that were each signed off
# already.
case "$source" in
merge | squash)
	exit 0
	;;
esac

# During a rebase the trailer is either already present or being added by
# --signoff, and appending here would double it. `git rebase --signoff` is the
# documented recovery for a branch that missed the line, so this must not fight
# it.
git_dir="$(git rev-parse --git-dir)"
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
	exit 0
fi

name="$(git config user.name || true)"
email="$(git config user.email || true)"
if [ -z "$name" ] || [ -z "$email" ]; then
	echo "prepare-commit-msg: user.name and user.email must be set to sign off" >&2
	echo "  git config user.name 'Your Name'" >&2
	echo "  git config user.email 'you@example.com'" >&2
	exit 1
fi

# `git interpret-trailers` rather than `echo >>`: it knows where the trailer
# block belongs, keeps a blank line before it, and does not append below the
# comment block that Git puts at the end of a commit template.
git interpret-trailers --in-place \
	--trailer "Signed-off-by: $name <$email>" \
	"$msg_file"
